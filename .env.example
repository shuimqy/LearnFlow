APP_MODE=multiuser
POSTGRES_DB=learnflow
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow_local
DATABASE_URL=postgresql+psycopg://learnflow:learnflow_local@127.0.0.1:5432/learnflow
TEST_DATABASE_URL=postgresql+psycopg://learnflow:learnflow_local@127.0.0.1:5432/learnflow_test
MANAGE_LOCAL_POSTGRES=false
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
COOKIE_SECURE=false
MAX_UPLOAD_MB=25
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=aliyun
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_AUTO_INDEX=true
MODEL_ENCRYPTION_KEY=
RAG_MIN_SIMILARITY=0.45
CHAT_MAX_TOKENS=4096
LLM_API_KEY=
LLM_PROVIDER=aliyun
LLM_STRUCTURED_OUTPUT=json_schema
LLM_VISION=true
LLM_BASE_URL=
LLM_MODEL=qwen3.8-flash
LLM_MAX_TOKENS=2048
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=60
EXTRACTION_AUTO_START=true
DOCUMENT_AUTO_ORGANIZE=true
EXTRACTION_MAX_PAGES=300
EXTRACTION_MAX_TOKENS=8192
