{
  "name": "learnflow-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests scripts *.ts package.json ../scripts/*.mjs",
    "format": "prettier --write src tests scripts *.ts package.json ../scripts/*.mjs",
    "test:e2e": "playwright test",
    "test:e2e:personal": "playwright test --config playwright.personal.config.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  }
}
